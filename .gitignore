models/*.pth
models/*.pt

# Output
output/

# Local review artifacts (internal only — must not reach the public repo)
semantic-review/

# Internal coordination notes (name individuals, internal branch/MR refs, and
# unmitigated security findings). Must not reach the public repo — keep these in
# the team wiki, not in git.
docs/UI_BACKEND_DEPENDENCIES.md

# Internal planning and coordination artifacts. These are working documents for the
# team, not part of the published guidance: AI-DLC process output including a
# verbatim meeting transcript, per-person task assignments and dates, and internal
# review/process references. Kept locally, excluded from the repo.
aidlc-docs/
docs/task-tracker.md
docs/meeting-agenda.md

# Terraform plan artifacts
infrastructure/tfplan
*.tfplan

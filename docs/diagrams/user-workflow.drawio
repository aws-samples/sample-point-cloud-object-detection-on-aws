        <mxCell id="review" value="Review results&lt;br&gt;in 3D viewer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="580" y="265" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="decide" value="Detections&lt;br&gt;capture intent?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="580" y="410" width="220" height="130" as="geometry" />

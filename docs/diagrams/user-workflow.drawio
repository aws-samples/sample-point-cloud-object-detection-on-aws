        <mxCell id="edit" value="Edit annotations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="925" y="260" width="370" height="80" as="geometry" />
        </mxCell>
        <mxCell id="train" value="Run fine-tuning job&lt;br&gt;on baseline or latest model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="925" y="395" width="370" height="90" as="geometry" />
        </mxCell>
        <mxCell id="register" value="Register fine-tuned model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="925" y="540" width="370" height="80" as="geometry" />

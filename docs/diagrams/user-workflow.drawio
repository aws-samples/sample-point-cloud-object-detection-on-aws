<mxfile host="app.diagrams.net" agent="Kiro" type="device">
  <diagram id="pcod-user-workflow" name="User Workflow">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1450" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="detectionGroup" value="DETECTION — required entry point" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#6C8EBF;verticalAlign=top;align=center;spacingTop=10;fontSize=18;fontStyle=1;fontColor=#3B5F8A;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="240" y="190" width="600" height="390" as="geometry" />
        </mxCell>
        <mxCell id="fineTuneGroup" value="FINE-TUNING — optional, iterative" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#9673A6;verticalAlign=top;align=center;spacingTop=10;fontSize=18;fontStyle=1;fontColor=#6C4F82;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="890" y="190" width="440" height="500" as="geometry" />
        </mxCell>

        <mxCell id="zoo" value="Model Zoo&lt;br&gt;pre-trained + fine-tuned" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="540" y="40" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="upload" value="Upload&lt;br&gt;point cloud" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="265" width="170" height="80" as="geometry" />

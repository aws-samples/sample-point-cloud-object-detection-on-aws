        <mxCell id="e2" value="select model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;exitX=0.15;exitY=1;entryX=0.25;entryY=0;fontSize=14;labelBackgroundColor=#FFFFFF;strokeWidth=1.5;" edge="1" parent="1" source="zoo" target="runDetect">

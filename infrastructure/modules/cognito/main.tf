# Sign-in for the internet-facing deployment (access_mode = "public").
#
# The application contains no authentication code. The ALB runs the
# authenticate-cognito action on every listener rule (helm/frontend ingress.yaml), so
# an unauthenticated request never reaches a pod. This module is the identity side of
# that: a user pool, its hosted sign-in domain, and one confidential app client that
# only the ALB uses.
#
# Nothing here is a stored credential of the sample. The client secret is generated by
# Cognito and read by the ALB itself through cognito-idp:DescribeUserPoolClient, which
# the Load Balancer Controller's IRSA role grants
# (modules/addons/alb-controller-iam-policy.json; deploy.sh annotates the controller's
# service account with that role). It does land in Terraform state, as
# every resource attribute does; the S3 backend encrypts state at rest (backend.tf).

data "aws_caller_identity" "current" {}

locals {
  # The ELB guide requires the callback URL to be all lowercase.
  host = lower(var.app_host)

  # Prefix domains are global per Region, so the prefix needs to be unique without
  # asking the operator to invent one. A short hash of account and Region does that
  # and is stable across applies. The raw account ID is deliberately not used: the
  # sign-in URL is public.
  domain_prefix = "${var.prefix}-${substr(sha256("${data.aws_caller_identity.current.account_id}-${var.region}"), 0, 8)}"
}

resource "aws_cognito_user_pool" "this" {
  name = "${var.prefix}-users"

  # Off so destroy.sh can remove the pool with the rest of the stack. The pool holds
  # only sign-in identities; no application data lives here.
  deletion_protection = "INACTIVE"

  # Operators create every user (aws cognito-idp admin-create-user). Self sign-up
  # would let anyone on the internet make an account and walk through the ALB.
  admin_create_user_config {
    allow_admin_create_user_only = true

    invite_message_template {
      email_subject = "Your Point Cloud Detection sign-in"
      email_message = "Sign in at https://${local.host}/ with username {username} and temporary password {####}. You will be asked to choose a new password."
      # Never sent: the pool has no SMS configuration. Without it the provider sends an
      # empty SMS template, which Cognito rejects (6 to 140 characters), so the first
      # public-mode deploy, on a sandbox account, stopped at CreateUserPool.
      sms_message = "Point Cloud Detection: username {username}, temporary password {####}"
    }
  }

  username_attributes      = ["email"]
  auto_verified_attributes = ["email"]

  username_configuration {
    case_sensitive = false
  }

  account_recovery_setting {
    recovery_mechanism {
      name     = "verified_email"
      priority = 1
    }
  }

  password_policy {
    minimum_length                   = 14
    require_lowercase                = true
    require_uppercase                = true
    require_numbers                  = true
    require_symbols                  = true
    temporary_password_validity_days = 7
  }

  # TOTP only; no SMS configuration, so no SMS spend and no phone numbers held. See
  # var.mfa_configuration for what OPTIONAL does and does not give you.
  mfa_configuration = var.mfa_configuration

  software_token_mfa_configuration {
    enabled = true
  }

  # No user_pool_add_ons block: advanced security (AUDIT/ENFORCED) moves the pool to
  # the Plus feature plan, which has no free tier.
}

# Classic hosted UI (managed_login_version 1). Version 2 shows no sign-in page until
# a branding style is created, and provider 5.x has no resource for one.
resource "aws_cognito_user_pool_domain" "this" {
  domain                = local.domain_prefix
  user_pool_id          = aws_cognito_user_pool.this.id
  managed_login_version = 1
}

# The one client, used by the ALB and nothing else. The ELB guide requires a
# generated secret, the authorization code grant, and the same scopes the ALB asks
# for (helm/frontend values.yaml ingress.auth.scope).
resource "aws_cognito_user_pool_client" "alb" {
  name         = "${var.prefix}-alb"
  user_pool_id = aws_cognito_user_pool.this.id

  generate_secret                      = true
  allowed_oauth_flows_user_pool_client = true
  allowed_oauth_flows                  = ["code"]
  allowed_oauth_scopes                 = ["openid", "email"]
  supported_identity_providers         = ["COGNITO"]

  # The ALB handles /oauth2/idpresponse itself. Only the configured hostname is
  # registered, so sign-in works on https://<app_host>/ and not on the ALB's own DNS
  # name.
  callback_urls = ["https://${local.host}/oauth2/idpresponse"]
  # Where Cognito's /logout sends the browser after Sign out: the sign-in page again,
  # through the ALB's authenticate action. The ELB guide says a logout landing page
  # must be unauthenticated. This one is not, because every rule on the listener
  # authenticates by design; whether sign-out holds when the ALB refreshes an expired
  # access token on the /signout request itself is unverified (THREAT_MODEL.md 4.5).
  logout_urls = ["https://${local.host}/"]

  explicit_auth_flows           = ["ALLOW_REFRESH_TOKEN_AUTH", "ALLOW_USER_SRP_AUTH"]
  prevent_user_existence_errors = "ENABLED"
  enable_token_revocation       = true

  # @secure_recommendation: least data. Unset, a client may read every attribute of
  # every user, and the ALB copies what the userInfo endpoint returns into the
  # x-amzn-oidc-data header on each request to the pods. The ALB asks for the email
  # scope and the application reads no claim at all, so email and email_verified are
  # the whole need. sub is not listed because it is not optional: OpenID Connect
  # requires it in every ID token and userInfo response.
  read_attributes = ["email", "email_verified"]

  # The ALB re-checks Cognito only when the access token expires, so its lifetime is
  # how long a user keeps access after admin-disable-user or admin-user-global-sign-out,
  # which revoke the user's tokens. The UI's Sign out revokes nothing: it expires the
  # cookie in that browser and calls Cognito's /logout, which the token-revocation
  # documentation does not list among the ways to revoke a refresh token. A copy of the
  # cookie taken before Sign out keeps working until the session ends. The refresh
  # token must last at least as long as the ALB session, or users are sent to sign in
  # mid-session.
  access_token_validity  = var.access_token_minutes
  id_token_validity      = var.access_token_minutes
  refresh_token_validity = var.session_hours

  token_validity_units {
    access_token  = "minutes"
    id_token      = "minutes"
    refresh_token = "hours"
  }
}

# ---------------------------------------------------------------------------
# Failed sign-in alarm
# ---------------------------------------------------------------------------
# @secure_recommendation: alert on password guessing against the hosted sign-in page.
# The pool has no threat protection (a Plus plan feature; see the user pool above), so
# this alarm is the only notice an operator gets of repeated failures.
#
# SignInSuccesses records 1 for each successful authentication and 0 for each failed
# or throttled one, per user pool and app client, so SampleCount is attempts and Sum is
# successes. Their difference is failures, as the Cognito metrics reference describes.
# Refresh-token renewals are counted separately and do not appear here. With no
# sign-ins at all there is no data, which is not a breach.
resource "aws_cloudwatch_metric_alarm" "failed_sign_ins" {
  alarm_name          = "${var.prefix}-cognito-failed-sign-ins"
  alarm_description   = "At least ${var.failed_sign_in_threshold} failed sign-ins to the ALB app client in 5 minutes: possible password guessing against the hosted sign-in page."
  comparison_operator = "GreaterThanOrEqualToThreshold"
  evaluation_periods  = 1
  threshold           = var.failed_sign_in_threshold
  treat_missing_data  = "notBreaching"
  alarm_actions       = var.alarm_topic_arn != "" ? [var.alarm_topic_arn] : []

  metric_query {
    id          = "failed"
    expression  = "attempts - successes"
    label       = "Failed sign-ins"
    return_data = true
  }

  metric_query {
    id = "attempts"
    metric {
      namespace   = "AWS/Cognito"
      metric_name = "SignInSuccesses"
      period      = 300
      stat        = "SampleCount"
      dimensions = {
        UserPool       = aws_cognito_user_pool.this.id
        UserPoolClient = aws_cognito_user_pool_client.alb.id
      }
    }
  }

  metric_query {
    id = "successes"
    metric {
      namespace   = "AWS/Cognito"
      metric_name = "SignInSuccesses"
      period      = 300
      stat        = "Sum"
      dimensions = {
        UserPool       = aws_cognito_user_pool.this.id
        UserPoolClient = aws_cognito_user_pool_client.alb.id
      }
    }
  }
}
